# Copy to .env and fill in values before running locally or deploying.
# Backend model checkpoint path (if using local file)
CHECKPOINT_PATH=best_model.pth

# Gemini (LLM) config (optional) — required for /api/chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional threshold override
THRESHOLD=0.5
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
