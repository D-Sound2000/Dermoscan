# Copy to .env and fill in values before running locally or deploying.
# Backend model checkpoint path (if using local file)
CHECKPOINT_PATH=best_model.pth
# Optional remote checkpoint source when the image does not contain the model
CHECKPOINT_URL=

# Comma-separated browser origins allowed to call the backend directly
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Preview deployments are allowed by default; override only if needed
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Gemini (LLM) config (optional) — required for /api/chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional calibrated-classification threshold override
THRESHOLD=
