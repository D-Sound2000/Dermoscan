{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "model",
          "format": "url",
          "env": "MODEL_URL"
        }
      ]
    },
    "model": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
